# AI-Driven DL-ML Crop Yield Research Platform Environment Configuration
# Copy this file to .env and configure settings accordingly.

APP_NAME="AI-Driven DL-ML Crop Yield Research Platform"
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite)
DATABASE_URL=sqlite:///crop_yield_platform.db
