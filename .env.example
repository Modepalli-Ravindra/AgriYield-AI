# AI-Driven DL-ML Crop Yield Research Platform Environment Configuration
# Copy this file to .env and configure secrets accordingly.

APP_NAME="AI-Driven DL-ML Crop Yield Research Platform"
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default fallback is local SQLite. For InsForge / Production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/crop_yield_db
DATABASE_URL=sqlite:///./crop_yield_platform.db

# InsForge Managed PostgreSQL Settings (Optional)
INSFORGE_PROJECT_ID=
INSFORGE_API_KEY=
INSFORGE_DB_HOST=
INSFORGE_DB_PORT=5432
INSFORGE_DB_NAME=postgres
INSFORGE_DB_USER=postgres
INSFORGE_DB_PASSWORD=
