# AI-Driven DL-ML Crop Yield Research Platform Environment Configuration
# Copy this file to .env and configure secrets accordingly.

APP_NAME="AI-Driven DL-ML Crop Yield Research Platform"
APP_ENV=development
API_V1_STR=/api/v1
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# InsForge PostgreSQL production connection string format:
# DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<dbname>
# Local SQLite development fallback:
# DATABASE_URL=sqlite:///./crop_yield_platform.db
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.insforge.app:5432/postgres

# InsForge Managed PostgreSQL Settings (Optional)
INSFORGE_PROJECT_ID=your-project-id-here
INSFORGE_API_KEY=your-server-api-key-here
INSFORGE_DB_HOST=db.your-project-ref.insforge.app
INSFORGE_DB_PORT=5432
INSFORGE_DB_NAME=postgres
INSFORGE_DB_USER=postgres
INSFORGE_DB_PASSWORD=your-database-password-here
